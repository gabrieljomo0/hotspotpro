{
  "name": "hotspotpro-backend",
  "version": "1.0.0",
  "private": true,
  "description": "HotspotPro backend: HTTP API, database, auth, payments, SMS, RADIUS server and router provisioning.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node dist/server.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "routes": "node scripts/gen-routes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-test.mjs && node scripts/radius-test.mjs",
    "reset-password": "node scripts/reset-password.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
