# Copy this file to ".env" (same folder) and edit. Every line is optional.

# FIRST-TIME SETUP: the first person to open the site creates the SUPER ADMIN account on the
# sign-up page (/login?mode=register). Everyone after that signs up as a separate business
# (the super admin can switch that off). There is NO default password. On a public server,
# set a setup code so nobody else can claim the site before you do; the first sign-up page then asks for it:
# HOTSPOTPRO_SETUP_CODE=choose-a-secret-code

# Optional alternative: create the super admin account from these settings on first start
# (no sign-up page needed). Use a strong password.
# HOTSPOTPRO_ADMIN_EMAIL=you@example.com
# HOTSPOTPRO_ADMIN_PASSWORD=

# Forgot the password? Stop the server, then:  node scripts/reset-password.mjs you@example.com "new-password"

# Secret used to sign login cookies. If left out, a random one is created
# once and stored in data/secret.key. Set it explicitly when you run more
# than one server, or want logins to survive deleting the data folder.
# HOTSPOTPRO_SESSION_SECRET=put-a-long-random-string-here

# Where the server keeps its database (default: ./data).
# HOTSPOTPRO_DATA_DIR=./data

# Hosted database (Supabase). When both are set, the JSON database is saved there
# so it survives a new deploy. Use the service_role key, and keep it on the server only.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# The public address routers use to reach this server, e.g. https://billing.example.com
# Needed when you reach the dashboard on localhost but routers are on another network.
# HOTSPOTPRO_PUBLIC_URL=https://billing.example.com

# Hubtel / WhatsApp provider callbacks: if set, the callback address must include
# ?secret=<value> (or an x-webhook-secret header) or it is rejected.
# HOTSPOTPRO_HUBTEL_WEBHOOK_SECRET=
# HOTSPOTPRO_WHATSAPP_WEBHOOK_SECRET=

# Set to 1 only if you serve the production build over plain http (no https).
# HOTSPOTPRO_INSECURE_COOKIES=1

# ---- Online payments (Hubtel) -------------------------------------------------
# Live payments need Settings -> Payments filled in (Hubtel API ID, key and
# Collection Account Number) with "Sandbox mode" OFF.
# While developing (npm run dev) customers get a TEST payment with an
# "Approve" button instead. In production that test mode is OFF unless you set:
# HOTSPOTPRO_PAYMENTS_SANDBOX=1

# ---- RADIUS (routers asking "may this voucher get online?") -------------------
# The server listens on UDP 1812 (login) and 1813 (usage). Open those ports on
# your server's firewall. Routers must reach this address - use the server's
# public IP address (MikroTik wants an IP here):
# HOTSPOTPRO_RADIUS_HOST=203.0.113.10
# HOTSPOTPRO_RADIUS_PORT=1812
# HOTSPOTPRO_RADIUS_ACCT_PORT=1813
# HOTSPOTPRO_RADIUS_SECRET=            (random one is created if left out)
# HOTSPOTPRO_RADIUS=off                (turn the RADIUS server off)
